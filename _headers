# Netlify / Cloudflare Pages güvenlik başlıkları
# (Bu dosya yalnızca bu iki platformda otomatik uygulanır. Apache için .htaccess,
#  Nginx için sunucu bloğu kullanılmalı — GUVENLIK-RAPORU'na bakın.)

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' https://images.unsplash.com; frame-src https://www.google.com; connect-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Hassas dosyalara erişimi engelle (yanlışlıkla yüklenirse)
/şifre.txt
  X-Robots-Tag: noindex
/*.md
  X-Robots-Tag: noindex
